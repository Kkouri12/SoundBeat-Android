<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/sb_w_bg">
  <ImageView android:id="@+id/w_art" android:layout_width="96dp" android:layout_height="96dp" android:scaleType="centerCrop"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="8dp">
      <ImageButton android:id="@+id/w_prev" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:tint="#FFFFFF" android:src="@android:drawable/ic_media_previous"/>
      <ImageButton android:id="@+id/w_pp" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginHorizontal="10dp" android:background="@drawable/sb_w_btn" android:tint="#FFFFFF" android:src="@android:drawable/ic_media_play"/>
      <ImageButton android:id="@+id/w_next" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:tint="#FFFFFF" android:src="@android:drawable/ic_media_next"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
